# Server Configuration
PORT=5000
NODE_ENV=production

# Security Keys (generate strong random strings for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ENCRYPTION_KEY=your-32-character-encryption-key!

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# Frontend URL (your Vercel deployment URL)
FRONTEND_URL=https://your-app.vercel.app

# Base URL for QR code generation (same as FRONTEND_URL)
BASE_URL=https://your-app.vercel.app

# Default admin credentials (used on first database init)
ADMIN_EMAIL=admin@altransecurity.co.zw
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=System Administrator
ADMIN_PHONE=+263000000000
